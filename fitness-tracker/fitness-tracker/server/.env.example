# Copy this file to ".env" (same folder) and edit it.
PORT=5000

# Option A: MongoDB installed on your own computer
MONGO_URI=mongodb://127.0.0.1:27017/fittrack

# Option B: MongoDB Atlas (free cloud database) - paste YOUR connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/fittrack?retryWrites=true&w=majority
